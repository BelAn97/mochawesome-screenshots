{
  "name": "mochawesome-screenshots",
  "version": "2.1.0",
  "description": "A Gorgeous HTML/CSS Reporter for Mocha.js with Screenshot Support",
  "type": "module",
  "scripts": {
    "build": "npm run build:templates && npm run build:lib && npm run build:assets",
    "build:templates": "node scripts/build-templates.mjs",
    "build:lib": "tsup",
    "build:assets": "node scripts/build-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "npm run build:templates && npm run lint:eslint && npm run lint:tsc",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "npm run build && npm run test:unit && npm run test:smoke",
    "test:unit": "node --test",
    "test:smoke": "node scripts/run-smoke.mjs",
    "prepack": "npm run build"
  },
  "author": "Andrei Belousov",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/BelAn97/mochawesome-screenshots"
  },
  "keywords": [
    "mocha",
    "mochawesome",
    "reporter",
    "screenshots",
    "html-report",
    "playwright",
    "cypress",
    "webdriverio"
  ],
  "engines": {
    "node": ">= 20.0.0"
  },
  "main": "./dist/cjs/mochawesome.cjs",
  "types": "./dist/esm/mochawesome.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/mochawesome.d.ts",
        "default": "./dist/esm/mochawesome.js"
      },
      "require": {
        "types": "./dist/cjs/mochawesome.d.cts",
        "default": "./dist/cjs/mochawesome.cjs"
      }
    },
    "./logReport": {
      "import": {
        "types": "./dist/esm/logReport.d.ts",
        "default": "./dist/esm/logReport.js"
      },
      "require": {
        "types": "./dist/cjs/logReport.d.cts",
        "default": "./dist/cjs/logReport.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "dayjs": "^1.11.13",
    "diff": "^8.0.4",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.12.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "mocha": ">= 10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/handlebars": "^4.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "bootstrap": "^3.4.1",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "less": "^4.9.1",
    "mocha": "^12.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.6",
    "should": "^13.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
